# ---------------------------------------------------------
# Young Heroes - settings
#
# Every game works with NO key at all, so this file is optional.
# Locally, the easiest way to fill it in is:  npm run set-key
# ---------------------------------------------------------

# Your OpenAI key - https://platform.openai.com/api-keys
# NEVER commit the real key. .env is already in .gitignore.
OPENAI_API_KEY=

# Any chat model your key can use. gpt-4o-mini is cheap and fast.
OPENAI_MODEL=gpt-4o-mini

# Only change this if you use an OpenAI-compatible proxy.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Port for the local server
PORT=3000


# --------- PUBLIC DEPLOYMENT (Vercel) ---------
# On a public site your key pays for every visitor, so AI stays
# OFF unless you deliberately switch it on here.
# Set these in Vercel -> Project -> Settings -> Environment Variables.

# Set to true only when you accept the cost of public AI use.
ENABLE_PUBLIC_AI=false

# Comma-separated domains allowed to call the AI endpoint.
# Subdomains are included automatically. Leave blank to allow any
# origin (not recommended once ENABLE_PUBLIC_AI is true).
ALLOWED_HOSTS=younghero.com,your-project.vercel.app

# Hard ceilings so a bad day cannot become a big bill.
AI_DAILY_CAP=500
AI_RATE_PER_10MIN=40
